                        {
                            "type": "text",
                            "label": "Open Data Portal base URL",
                            "field": "portal_base_url",
                            "defaultValue": "https://www.data.qld.gov.au",
                            "help": "Base URL of the Queensland Government Open Data Portal (fixed; all presets and most public datasets live here).",
                            "required": true,
                            "validators": [
                                {
                                    "type": "url",
                                    "errorMsg": "Open Data Portal base URL must be a valid URL."
                                }
                            ],
                            "options": {
                                "enable": false
                            }
                        },
                        {
                            "type": "text",
                            "label": "Resource ID",
                            "field": "resource_id",
                            "help": "The dataset's resource_id on the Open Data Portal. Auto-filled if you picked a popular dataset above, or find it yourself on the dataset's page/API info panel (look for resource_id in the URL or the API example snippet).",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Resource ID must be a valid UUID.",
                                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                                }
                            ]
                        },
                        {
                            "type": "multipleSelect",
                            "label": "Fields to ingest",
                            "field": "selected_fields",
                            "help": "Choose which fields to ingest. The list refreshes automatically from the Open Data Portal once the base URL and Resource ID are filled in. Leave empty to ingest every field. Labels show the resulting Splunk field name (Splunk naming standard: lowercase, underscores only); values sent to the API are the original source field ids.",
                            "required": false,
                            "options": {
                                "referenceName": "open_data_fields",
                                "dependencies": [
                                    "portal_base_url",
                                    "resource_id"
                                ],
                                "labelField": "label",
                                "valueField": "value",
                                "delimiter": ","
                            }
                        },
                        {
                            "type": "text",
                            "label": "Sourcetype",
                            "field": "sourcetype",
                            "defaultValue": "qldgov:opendata:record",
                            "help": "Sourcetype assigned to ingested events. Auto-filled as qldgov:opendata:<dataset> when you pick a popular dataset above; edit freely for custom resources.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Sourcetype must be lowercase alphanumeric segments separated by colons, e.g. qldgov:opendata:record.",
                                    "pattern": "^[a-z0-9]+(:[a-z0-9_]+)*$"
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Page size",
                            "field": "page_size",
                            "defaultValue": "1000",
                            "help": "Number of records to request per datastore_search page (advanced; default 1000 works for most datasets).",
                            "required": false,
                            "validators": [
                                {
                                    "type": "number",
                                    "errorMsg": "Page size must be a positive integer.",
                                    "range": [
                                        1,
                                        32000
                                    ]
                                }
                            ]
                        }
                    ],
